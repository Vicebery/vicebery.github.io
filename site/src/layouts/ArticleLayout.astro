---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { displayDate } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  Content: any;
}

const { post, Content } = Astro.props;
const description = post.data.description ?? `${post.data.title}｜vicebery`;
---

<BaseLayout title={`${post.data.title} · vicebery`} description={description} enHref="/en/writing/">
  <article class="article shell narrow">
    <header class="article-header">
      <p class="eyebrow">{post.data.categories[0] ?? '文章'}</p>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time>
      {post.data.tags.length > 0 && (
        <ul class="tag-list article-tags" aria-label="Tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="prose"><Content /></div>
    <footer class="article-footer">
      <a href="/writing/">← 返回文章归档</a>
    </footer>
  </article>
</BaseLayout>
