---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="vicebery · Personal website" lang="en" zhHref="/" description="Vicebery's personal website: technology, notes, and ongoing work.">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Personal website · since 2017</p>
        <h1>Technology, notes, and a life in progress.</h1>
        <p>This is vicebery’s personal space for technical notes, thoughtful writing, and the work still taking shape.</p>
      </div>
      <div class="avatar-frame">
        <img src="/avatar.jpeg" alt="vicebery" width="240" height="240" />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell now-card">
      <p class="eyebrow">Writing</p>
      <div>
        <h2>Translations, gradually.</h2>
        <p>The archive was originally written in Chinese. English editions will appear as articles are revised and translated.</p>
      </div>
    </div>
  </section>
</BaseLayout>
